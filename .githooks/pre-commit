#!/usr/bin/env bash
# PRISM pre-commit hook — blocks credentials from being committed.
# Enable once with:  git config core.hooksPath .githooks
staged="$(git diff --cached --name-only --diff-filter=ACM)"
[ -z "$staged" ] && exit 0
root="$(git rev-parse --show-toplevel)"
exec bash "$root/scripts/scan-secrets.sh" $staged
